      "kako": {
        "title": "Kako naručiti",
        "intro": "",
        "steps": [
          {
            "title": "Izaberite sortu.",
            "text": "U katalogu otvorite sortu, izaberite sadnicu ili reznicu i količinu, pa dodajte u korpu."
