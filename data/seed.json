          {
            "title": "Pošaljite upit.",
            "text": "U korpi upišite ime i telefon. Poruka se složi sama, a vi je šaljete preko WhatsApp-a ili e-maila."
          },
          {
            "title": "Dogovor.",
            "text": "Javimo vam se, potvrdimo dostupnost i cijenu i dogovorimo preuzimanje."
          }
        ],
        "seoTitle": "",
        "seoDescription": ""
      },
      "kontakt": {
        "title": "Vinograd iz Foče",
